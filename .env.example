# Names only. Real values live in git-ignored .env files (apps/api/.env, packages/db/.env).
# Local dev values are shown where they are not secrets.

# --- Database (Supabase Postgres, Mumbai ap-south-1; local: docker-compose PostGIS) ---
# Runtime, used by the API: Supabase *transaction pooler* (port 6543) as the non-superuser
# `ariforce_app` role (Supavisor user format: ariforce_app.<project-ref>). Never service_role/postgres.
DATABASE_URL=postgres://ariforce_app:ariforce_app@localhost:5432/ariforce
# Migrations + seed only: Supabase *direct* connection (port 5432) as the owner (postgres).
DIRECT_URL=postgres://postgres:postgres@localhost:5432/ariforce
# Password set for ariforce_app by db:migrate outside production (local/CI only).
APP_DB_PASSWORD=

# --- Auth (better-auth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# --- Files: Cloudflare R2 (S3 API, presigned URLs) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com (S3 endpoint)
R2_ENDPOINT=
# Optional public/custom domain for non-private assets
R2_PUBLIC_URL=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_MOCKING=enabled
