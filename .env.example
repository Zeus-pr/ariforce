# Names only. Real values live in git-ignored .env files (apps/api/.env, packages/db/.env).
# Local dev values are shown where they are not secrets.

# --- Database (Supabase Postgres, Mumbai ap-south-1; local: docker-compose PostGIS) ---
# Runtime, used by the API: Supabase *transaction pooler* (port 6543) as the non-superuser
# `ariforce_app` role (Supavisor user format: ariforce_app.<project-ref>). Never service_role/postgres.
DATABASE_URL=postgres://ariforce_app:ariforce_app@localhost:5432/ariforce
# Migrations + seed only: Supabase *direct* connection (port 5432) as the owner (postgres).
DIRECT_URL=postgres://postgres:postgres@localhost:5432/ariforce
# Password set for ariforce_app by db:migrate outside production (local/CI only).
APP_DB_PASSWORD=

# --- Auth (better-auth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
# Comma-separated browser origins (CORS with credentials + better-auth). Default:
# http://localhost:3000,http://localhost:3200
WEB_ORIGIN=
# API port (default 4000)
PORT=
# dev/test only: return the invite link in API responses instead of mailing it
INVITE_RETURN_LINK=http://localhost:3000

# --- Runtime / hardening (API) ---
# production enables fail-fast env validation at boot (apps/api/src/env.ts, docs/SECURITY.md)
NODE_ENV=
# Express trust proxy (required in production), e.g. loopback or the proxy's address
TRUST_PROXY=
# Optional: DB pool size, expense approval levels (1|2), sign-up limits, Turnstile
DB_POOL_MAX=
EXPENSE_APPROVAL_LEVELS=
SIGNUP_COMPANY_SLUG=
SIGNUP_RATE_PER_IP=
SIGNUP_RATE_PER_EMAIL=
TURNSTILE_SECRET=
# Client IP for limits/audit: cloudflare (trust CF-Connecting-IP; origin reachable only via
# Cloudflare) or socket (default). X-Forwarded-For is never trusted.
CLIENT_IP_MODE=
# Per-IP limits: sign-in per 15 min (other auth POSTs 3x), invite accept per hour
AUTH_RATE_PER_IP=
INVITE_RATE_PER_IP=

# --- Background jobs / notifications (#35, docs/NOTIFICATIONS.md) ---
# Runner default: on when NODE_ENV=production, off otherwise. Poll interval (ms), batch size,
# seconds before a running job is considered stuck and reclaimed.
JOBS_RUNNER_ENABLED=
JOBS_POLL_MS=
JOBS_BATCH_SIZE=
JOBS_LOCK_TIMEOUT_S=

# --- Files: Cloudflare R2 (S3 API, presigned URLs) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com (S3 endpoint)
R2_ENDPOINT=
# Optional public/custom domain for non-private assets
R2_PUBLIC_URL=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_MOCKING=enabled
