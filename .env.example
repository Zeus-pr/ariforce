# Owner/migration connection (superuser locally; runs migrations + seed)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ariforce
# Runtime connection: non-superuser role so RLS applies (created by migrations)
DATABASE_URL_APP=postgres://ariforce_app:ariforce_app@localhost:5432/ariforce
BETTER_AUTH_SECRET=change-me-to-32+-random-chars
BETTER_AUTH_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_MOCKING=enabled
