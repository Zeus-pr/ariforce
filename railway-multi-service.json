{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "buildpacks": []
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "always",
    "restartPolicyMaxRetries": 0,
    "sleepApplication": false,
    "cronSchedule": null
  },
  "services": {
    "api": {
      "name": "ariforce-api",
      "dockerfile": "apps/api/Dockerfile",
      "context": ".",
      "buildArgs": {},
      "registryCredential": "",
      "deploymentDomain": "ariforce-api",
      "port": 4000,
      "healthcheckPath": "/v1/health",
      "variables": {
        "NODE_ENV": "production",
        "PORT": "4000"
      }
    },
    "web": {
      "name": "ariforce-web",
      "dockerfile": "apps/web/Dockerfile",
      "context": ".",
      "buildArgs": {},
      "registryCredential": "",
      "deploymentDomain": "ariforce-web",
      "port": 3000,
      "healthcheckPath": "/sign-in",
      "variables": {
        "NODE_ENV": "production",
        "NEXT_PUBLIC_API_MODE": "real"
      }
    }
  },
  "volumes": {
    "postgres": {
      "name": "postgres",
      "size": "10GB"
    }
  },
  "plugins": [
    {
      "name": "postgres",
      "version": "latest"
    }
  ]
}
