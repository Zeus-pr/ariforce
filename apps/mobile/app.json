{
  "expo": {
    "name": "AriForce",
    "slug": "ariforce",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "ariforce",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F8FD",
    "ios": {
      "bundleIdentifier": "in.arighna.ariforce",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AriForce uses your location for punch-in, outlet check-in, and Presentation geofence."
      }
    },
    "android": {
      "package": "in.arighna.ariforce",
      "adaptiveIcon": {
        "backgroundColor": "#F4F8FD",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/GoogleSans-Regular.ttf",
            "./assets/fonts/GoogleSans-Medium.ttf",
            "./assets/fonts/GoogleSans-SemiBold.ttf",
            "./assets/fonts/GoogleSans-Bold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F8FD",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 112
        }
      ],
      "./plugins/with-launch-window",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AriForce uses your photos to attach expense receipts.",
          "cameraPermission": "AriForce uses the camera to photograph expense receipts.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AriForce uses your location for punch-in, outlet check-in, and Presentation geofence."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://ariforce-api.arighnapharma.com",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "02d7dfb9-4f40-4dd3-9c94-db0bbcd5ee78"
      }
    },
    "owner": "zeus-pr"
  }
}
